    instruction: "Redesign Hero section for ECM focus, staggered animations, and amber color."
    replacement_infos {
      original_chunk {
        target_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport Link from \"next/link\";\nimport { ArrowRight, FileText } from \"lucide-react\";\n\nexport function Hero() {\n  return (\n    <section className=\"relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden\">\n      <div className=\"container mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        <div className=\"max-w-3xl\">\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.5 }}\n          >\n            <h1 className=\"text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight mb-6\">\n              Hi, I\'m <span className=\"text-blue-600 dark:text-blue-500\">Aly Abdelrahman</span>\n            </h1>\n          </motion.div>\n          \n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.5, delay: 0.1 }}\n          >\n            <h2 className=\"text-2xl sm:text-3xl font-medium text-neutral-600 dark:text-neutral-300 mb-6\">\n              Associate Software Engineer & ECM Technical Consultant\n            </h2>\n            <p className=\"text-lg text-neutral-500 dark:text-neutral-400 mb-8 max-w-2xl leading-relaxed\">\n              Specializing in Enterprise Content Management (ECM) and full-stack software engineering. Focused on building scalable microservices, clean architecture, and automating complex enterprise workflows.\n            </p>\n          </motion.div>\n\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.5, delay: 0.2 }}\n            className=\"flex flex-col sm:flex-row gap-4\"\n          >\n            <Link\n              href=\"#contact\"\n              className=\"inline-flex h-12 items-center justify-center rounded-md bg-blue-600 px-8 text-sm font-medium text-white shadow transition-colors hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-blue-700 disabled:pointer-events-none disabled:opacity-50\"\n            >\n              Get in touch\n              <ArrowRight className=\"ml-2 h-4 w-4\" />\n            </Link>\n            <Link\n              href=\"#projects\"\n              className=\"inline-flex h-12 items-center justify-center rounded-md border border-neutral-200 bg-white px-8 text-sm font-medium text-neutral-900 shadow-sm transition-colors hover:bg-neutral-100 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-neutral-950 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-50 dark:hover:bg-neutral-800 dark:hover:text-neutral-50\"\n            >\n              View Work\n              <FileText className=\"ml-2 h-4 w-4\" />\n            </Link>\n          </motion.div>\n        </div>\n      </div>\n      \n      {/* Decorative background elements */}\n      <div className=\"absolute inset-0 z-0 pointer-events-none\">\n        <div className=\"absolute top-1/4 left-3/4 w-96 h-96 bg-blue-400/20 rounded-full blur-3xl\" />\n        <div className=\"absolute bottom-1/4 -left-10 w-72 h-72 bg-purple-400/20 rounded-full blur-3xl\" />\n      </div>\n    </section>\n  );\n}"
        replacement_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport Link from \"next/link\";\nimport { ArrowRight, FileText } from \"lucide-react\";\n\nconst containerVariants = {\n  hidden: { opacity: 0 },\n  visible: {\n    opacity: 1,\n    transition: {\n      staggerChildren: 0.15,\n    },\n  },\n};\n\nconst itemVariants = {\n  hidden: { opacity: 0, y: 20 },\n  visible: {\n    opacity: 1,\n    y: 0,\n    transition: { duration: 0.5 },\n  },\n};\n\nexport function Hero() {\n  return (\n    <section className=\"relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden bg-white dark:bg-neutral-950 transition-colors\">\n      <div className=\"container mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        <motion.div\n          className=\"max-w-4xl\"\n          variants={containerVariants}\n          initial=\"hidden\"\n          animate=\"visible\"\n        >\n          <motion.div variants={itemVariants}>\n            <h1 className=\"text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight mb-6 text-neutral-900 dark:text-neutral-50\">\n              Hi, I\'m <span className=\"text-amber-600 dark:text-amber-500\">Aly Abdelrahman</span>\n            </h1>\n          </motion.div>\n          \n          <motion.div variants={itemVariants}>\n            <h2 className=\"text-2xl sm:text-3xl font-medium text-neutral-600 dark:text-neutral-300 mb-6\">\n              ECM Technical Consultant & Software Engineer\n            </h2>\n            <p className=\"text-lg text-neutral-500 dark:text-neutral-400 mb-8 max-w-2xl leading-relaxed\">\n              Specializing in Enterprise Content Management (ECM). I architect scalable microservices, develop complex IBM Datacap applications, administer CMOD infrastructures, and engineer seamless integrations between FileNet, FileTrail, and core banking systems.\n            </p>\n          </motion.div>\n\n          <motion.div variants={itemVariants} className=\"flex flex-col sm:flex-row gap-4\">\n            <Link\n              href=\"#projects\"\n              className=\"inline-flex h-12 items-center justify-center rounded-md bg-amber-600 px-8 text-sm font-medium text-white shadow transition-all hover:bg-amber-700 hover:shadow-lg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-amber-700 disabled:pointer-events-none disabled:opacity-50\"\n            >\n              View Enterprise Work\n              <ArrowRight className=\"ml-2 h-4 w-4\" />\n            </Link>\n            <Link\n              href=\"#contact\"\n              className=\"inline-flex h-12 items-center justify-center rounded-md border border-neutral-200 bg-transparent px-8 text-sm font-medium text-neutral-900 shadow-sm transition-all hover:bg-neutral-100 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-neutral-950 dark:border-neutral-800 dark:text-neutral-50 dark:hover:bg-neutral-900 dark:hover:text-neutral-50\"\n            >\n              Contact Me\n              <FileText className=\"ml-2 h-4 w-4\" />\n            </Link>\n          </motion.div>\n        </motion.div>\n      </div>\n      \n      {/* Subtle minimalist gradient background instead of colored blurs */}\n      <div className=\"absolute inset-0 z-0 pointer-events-none opacity-40 dark:opacity-20\">\n        <div className=\"absolute top-0 right-0 w-[800px] h-[800px] bg-gradient-to-bl from-amber-200/20 via-transparent to-transparent rounded-full blur-3xl\" />\n      </div>\n    </section>\n  );\n}"
      }
      num_matches: 1
    }
  }
