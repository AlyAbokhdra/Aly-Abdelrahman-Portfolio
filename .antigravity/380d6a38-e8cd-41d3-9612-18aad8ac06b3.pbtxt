    instruction: "Redesign experience section with hover animations and amber accents."
    replacement_infos {
      original_chunk {
        target_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport { Briefcase } from \"lucide-react\";\n\nconst experiences = [\n  {\n    role: \"Technical Consultant\",\n    company: \"Tier-1 Regional Bank\",\n    description: \"Engineered digital archiving solutions utilizing IBM FileNet, ICN, Datacap, CMOD, and Litera FileTrail. Developed 3 distinct integrations between FileNet and FileTrail. Created a SOAP WebService acting as a central integration point for the CRM department to upload, search, retrieve, and delete documents.\",\n  },\n  {\n    role: \"Support & Development Engineer\",\n    company: \"Leading Financial Institution\",\n    description: \"Supported CMOD, FileNet, and ICN infrastructures. Developed a custom upload utility enabling bulk archival of warehouse-scanned documents.\",\n  },\n  {\n    role: \"Implementation Engineer\",\n    company: \"Multinational Banking Client\",\n    description: \"Executed end-to-end implementation of a new branch archival system on FileNet and ICN. Engineered a custom batch-upload tool for processing monthly customer records.\",\n  },\n  {\n    role: \"Java Backend Engineer\",\n    company: \"Major Egyptian Bank\",\n    description: \"Architected a multi-threaded Java ingestion service running as a headless Windows service. This automated upload tool operates with zero human interaction, watching network drop-folders to capture, index, and ingest documents into FileNet P8.\",\n  },\n];\n\nexport function Experience() {\n  return (\n    <section id=\"experience\" className=\"py-20\">\n      <div className=\"container mx-auto px-4 sm:px-6 lg:px-8\">\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.5 }}\n          className=\"mb-12\"\n        >\n          <h2 className=\"text-3xl font-bold tracking-tight mb-2\">Work Experience</h2>\n          <div className=\"w-16 h-1 bg-blue-600 rounded\"></div>\n        </motion.div>\n\n        <div className=\"space-y-12\">\n          {experiences.map((exp, index) => (\n            <motion.div\n              key={index}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: index * 0.1 }}\n              className=\"relative pl-8 md:pl-0\"\n            >\n              <div className=\"md:grid md:grid-cols-4 md:gap-8 items-start\">\n                <div className=\"hidden md:flex flex-col items-end pt-1\">\n                  <div className=\"w-12 h-12 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center border border-neutral-200 dark:border-neutral-700 shadow-sm z-10\">\n                    <Briefcase className=\"h-5 w-5 text-neutral-500 dark:text-neutral-400\" />\n                  </div>\n                </div>\n                \n                {/* Mobile line and icon */}\n                <div className=\"absolute left-0 top-0 bottom-0 w-px bg-neutral-200 dark:bg-neutral-800 md:hidden\" />\n                <div className=\"absolute left-[-8px] top-2 w-4 h-4 rounded-full bg-blue-600 md:hidden border-4 border-white dark:border-neutral-950\" />\n\n                <div className=\"md:col-span-3 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow\">\n                  <h3 className=\"text-xl font-bold\">{exp.role}</h3>\n                  <p className=\"text-blue-600 dark:text-blue-500 font-medium mb-4\">{exp.company}</p>\n                  <p className=\"text-neutral-600 dark:text-neutral-300 leading-relaxed\">\n                    {exp.description}\n                  </p>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}"
        replacement_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport { Briefcase } from \"lucide-react\";\n\nconst experiences = [\n  {\n    role: \"Technical Consultant\",\n    company: \"Tier-1 Regional Bank\",\n    description: \"Engineered digital archiving solutions utilizing IBM FileNet, ICN, Datacap, CMOD, and Litera FileTrail. Developed 3 distinct integrations between FileNet and FileTrail. Created a SOAP WebService acting as a central integration point for the CRM department to upload, search, retrieve, and delete documents.\",\n  },\n  {\n    role: \"Java Backend Engineer\",\n    company: \"Major Egyptian Bank\",\n    description: \"Architected a multi-threaded Java ingestion service running as a headless Windows service. This automated upload tool operates with zero human interaction, watching network drop-folders to capture, index, and ingest documents into FileNet P8.\",\n  },\n  {\n    role: \"Implementation Engineer\",\n    company: \"Multinational Banking Client\",\n    description: \"Executed end-to-end implementation of a new branch archival system on FileNet and ICN. Engineered a custom batch-upload tool for processing monthly customer records.\",\n  },\n  {\n    role: \"Support & Development Engineer\",\n    company: \"Leading Financial Institution\",\n    description: \"Supported CMOD, FileNet, and ICN infrastructures. Developed a custom upload utility enabling bulk archival of warehouse-scanned documents.\",\n  },\n];\n\nconst containerVariants = {\n  hidden: { opacity: 0 },\n  visible: {\n    opacity: 1,\n    transition: { staggerChildren: 0.15 },\n  },\n};\n\nconst itemVariants = {\n  hidden: { opacity: 0, x: -20 },\n  visible: { opacity: 1, x: 0, transition: { duration: 0.5 } },\n};\n\nexport function Experience() {\n  return (\n    <section id=\"experience\" className=\"py-20 bg-white dark:bg-neutral-950 transition-colors\">\n      <div className=\"container mx-auto px-4 sm:px-6 lg:px-8\">\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.5 }}\n          className=\"mb-16\"\n        >\n          <h2 className=\"text-3xl font-bold tracking-tight mb-2 text-neutral-900 dark:text-neutral-50\">Work Experience</h2>\n          <div className=\"w-16 h-1 bg-amber-600 rounded\"></div>\n        </motion.div>\n\n        <motion.div \n          variants={containerVariants}\n          initial=\"hidden\"\n          whileInView=\"visible\"\n          viewport={{ once: true, margin: \"-100px\" }}\n          className=\"space-y-8\"\n        >\n          {experiences.map((exp, index) => (\n            <motion.div\n              key={index}\n              variants={itemVariants}\n              whileHover={{ scale: 1.01, x: 5 }}\n              className=\"relative pl-8 md:pl-0 transition-all duration-300\"\n            >\n              <div className=\"md:grid md:grid-cols-4 md:gap-8 items-start\">\n                <div className=\"hidden md:flex flex-col items-end pt-1 relative\">\n                  <div className=\"w-12 h-12 rounded-full bg-neutral-50 dark:bg-neutral-900 flex items-center justify-center border border-neutral-200 dark:border-neutral-800 shadow-sm z-10\">\n                    <Briefcase className=\"h-5 w-5 text-amber-600 dark:text-amber-500\" />\n                  </div>\n                  {/* Vertical line connecting timeline on desktop */}\n                  {index !== experiences.length - 1 && (\n                     <div className=\"absolute top-12 right-6 bottom-[-32px] w-px bg-neutral-200 dark:bg-neutral-800\" />\n                  )}\n                </div>\n                \n                {/* Mobile line and icon */}\n                <div className=\"absolute left-0 top-0 bottom-0 w-px bg-neutral-200 dark:bg-neutral-800 md:hidden\" />\n                <div className=\"absolute left-[-8px] top-4 w-4 h-4 rounded-full bg-amber-600 md:hidden border-4 border-white dark:border-neutral-950\" />\n\n                <div className=\"md:col-span-3 bg-neutral-50 dark:bg-neutral-900/50 border border-neutral-200 dark:border-neutral-800 rounded-lg p-6 md:p-8 hover:shadow-[0_0_15px_rgba(217,119,6,0.05)] hover:border-amber-500/30 transition-all duration-300\">\n                  <h3 className=\"text-xl font-bold text-neutral-900 dark:text-neutral-100\">{exp.role}</h3>\n                  <p className=\"text-amber-600 dark:text-amber-500 font-medium mb-4\">{exp.company}</p>\n                  <p className=\"text-neutral-600 dark:text-neutral-400 leading-relaxed\">\n                    {exp.description}\n                  </p>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </motion.div>\n      </div>\n    </section>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
