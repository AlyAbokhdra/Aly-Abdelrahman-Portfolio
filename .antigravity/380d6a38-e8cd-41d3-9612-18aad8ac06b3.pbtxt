    instruction: "Redesign projects section for ECM focus, add hover states and stagger, change colors."
    replacement_infos {
      original_chunk {
        target_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport { Code, Server, AppWindow, Smartphone } from \"lucide-react\";\n\nconst projects = [\n  {\n    title: \"JAX-RS Mock Banking API\",\n    category: \"Backend Development\",\n    icon: <Server className=\"h-6 w-6\" />,\n    description: \"Developed a Java-based REST API simulating core banking endpoints to facilitate downstream FileNet and capture system integration testing.\",\n    tech: [\"Java\", \"REST\", \"JAX-RS\"],\n  },\n  {\n    title: \"Datacap Barcode Injector\",\n    category: \"Utility Application\",\n    icon: <Code className=\"h-6 w-6\" />,\n    description: \"Built a JavaScript single-page application that generates and overlays QR codes and barcodes onto TIFF image files for automated IBM Datacap processing.\",\n    tech: [\"JavaScript\", \"SPA\", \"Image Processing\"],\n  },\n  {\n    title: \"Dynamic Invitations\",\n    category: \"Full-Stack Web\",\n    icon: <AppWindow className=\"h-6 w-6\" />,\n    description: \"Interactive web app built with React, Vite, Express, and MongoDB. Allows users to create and manage dynamic event invitations.\",\n    tech: [\"React\", \"Express\", \"MongoDB\", \"Vite\"],\n  },\n  {\n    title: \"SkillTrackr & Chat-App\",\n    category: \"Full-Stack Web\",\n    icon: <AppWindow className=\"h-6 w-6\" />,\n    description: \"Full-stack MERN applications demonstrating backend routing and state management with real-time features.\",\n    tech: [\"MERN Stack\", \"State Management\", \"WebSockets\"],\n  },\n  {\n    title: \"Cross-Platform Music Player\",\n    category: \"Mobile Application\",\n    icon: <Smartphone className=\"h-6 w-6\" />,\n    description: \"A Flutter-based music player integrating Firebase and Supabase for cross-platform playback and playlist management.\",\n    tech: [\"Flutter\", \"Firebase\", \"Supabase\"],\n  },\n];\n\nexport function Projects() {\n  return (\n    <section id=\"projects\" className=\"py-20 bg-neutral-50 dark:bg-neutral-900/50\">\n      <div className=\"container mx-auto px-4 sm:px-6 lg:px-8\">\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.5 }}\n          className=\"mb-12\"\n        >\n          <h2 className=\"text-3xl font-bold tracking-tight mb-2\">Independent Projects</h2>\n          <div className=\"w-16 h-1 bg-blue-600 rounded\"></div>\n        </motion.div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {projects.map((project, index) => (\n            <motion.div\n              key={index}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: index * 0.1 }}\n              className=\"bg-white dark:bg-neutral-900 rounded-lg border border-neutral-200 dark:border-neutral-800 p-6 flex flex-col h-full hover:border-blue-500/50 dark:hover:border-blue-500/50 transition-colors shadow-sm\"\n            >\n              <div className=\"w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-6\">\n                {project.icon}\n              </div>\n              <h3 className=\"text-xl font-bold mb-1\">{project.title}</h3>\n              <p className=\"text-sm text-neutral-500 dark:text-neutral-400 mb-4\">{project.category}</p>\n              <p className=\"text-neutral-600 dark:text-neutral-300 mb-6 flex-grow\">\n                {project.description}\n              </p>\n              <div className=\"flex flex-wrap gap-2 mt-auto\">\n                {project.tech.map((tech, techIndex) => (\n                  <span\n                    key={techIndex}\n                    className=\"text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 px-2 py-1 rounded\"\n                  >\n                    {tech}\n                  </span>\n                ))}\n              </div>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}"
        replacement_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport { Server, Database, Network, Code } from \"lucide-react\";\n\nconst ecmProjects = [\n  {\n    title: \"FileNet P8 Java Ingestion Service\",\n    category: \"Enterprise Infrastructure\",\n    icon: <Server className=\"h-6 w-6\" />,\n    description: \"Architected a multi-threaded Java ingestion service running as a headless Windows service. Automates document capture and ingestion into FileNet P8 via network drop-folders with zero human interaction.\",\n    tech: [\"Java\", \"IBM FileNet P8\", \"Multi-threading\"],\n  },\n  {\n    title: \"CRM & FileTrail SOAP Integration\",\n    category: \"System Integration\",\n    icon: <Network className=\"h-6 w-6\" />,\n    description: \"Created a central SOAP WebService acting as the primary integration point for CRM systems to upload, search, retrieve, and delete documents across FileNet and Litera FileTrail.\",\n    tech: [\"SOAP WebServices\", \"Java\", \"Litera FileTrail\"],\n  },\n  {\n    title: \"IBM CMOD Bulk Archival Utility\",\n    category: \"Data Management\",\n    icon: <Database className=\"h-6 w-6\" />,\n    description: \"Developed a custom high-throughput upload utility enabling the bulk archival of warehouse-scanned documents directly into IBM CMOD infrastructures.\",\n    tech: [\"IBM CMOD\", \"Java\", \"Batch Processing\"],\n  },\n  {\n    title: \"IBM Datacap Processing Suite\",\n    category: \"Document Automation\",\n    icon: <Code className=\"h-6 w-6\" />,\n    description: \"Engineered complex IBM Datacap applications for automated document processing, classification, and data extraction tailored for tier-1 financial institutions.\",\n    tech: [\"IBM Datacap\", \"VBScript\", \"C#\"],\n  },\n];\n\nconst additionalProjects = [\n  {\n    title: \"JAX-RS Mock Banking API\",\n    category: \"Backend Development\",\n    description: \"Developed a Java-based REST API simulating core banking endpoints to facilitate downstream FileNet integration testing.\",\n    tech: [\"Java\", \"JAX-RS\", \"REST\"],\n  },\n  {\n    title: \"Full-Stack Web & Mobile Apps\",\n    category: \"Independent Development\",\n    description: \"Built Dynamic Invitations (React/Express), SkillTrackr (MERN), and a Cross-Platform Music Player (Flutter/Firebase).\",\n    tech: [\"React\", \"Node.js\", \"Flutter\"],\n  },\n];\n\nconst containerVariants = {\n  hidden: { opacity: 0 },\n  visible: {\n    opacity: 1,\n    transition: { staggerChildren: 0.1 },\n  },\n};\n\nconst itemVariants = {\n  hidden: { opacity: 0, y: 20 },\n  visible: { opacity: 1, y: 0, transition: { duration: 0.5 } },\n};\n\nexport function Projects() {\n  return (\n    <section id=\"projects\" className=\"py-20 bg-neutral-50 dark:bg-neutral-900/30 transition-colors\">\n      <div className=\"container mx-auto px-4 sm:px-6 lg:px-8\">\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.5 }}\n          className=\"mb-12\"\n        >\n          <h2 className=\"text-3xl font-bold tracking-tight mb-2 text-neutral-900 dark:text-neutral-50\">Enterprise Engineering Work</h2>\n          <div className=\"w-16 h-1 bg-amber-600 rounded\"></div>\n          <p className=\"mt-4 text-neutral-600 dark:text-neutral-400 max-w-2xl\">\n            Primary focus on robust, highly scalable Enterprise Content Management solutions and automated ingestion pipelines.\n          </p>\n        </motion.div>\n\n        <motion.div\n          variants={containerVariants}\n          initial=\"hidden\"\n          whileInView=\"visible\"\n          viewport={{ once: true, margin: \"-100px\" }}\n          className=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-16\"\n        >\n          {ecmProjects.map((project, index) => (\n            <motion.div\n              key={index}\n              variants={itemVariants}\n              whileHover={{ scale: 1.02, y: -5 }}\n              className=\"bg-white dark:bg-neutral-950 rounded-lg border border-neutral-200 dark:border-neutral-800 p-8 flex flex-col h-full hover:shadow-[0_0_20px_rgba(217,119,6,0.15)] hover:border-amber-500/50 dark:hover:border-amber-500/50 transition-all duration-300\"\n            >\n              <div className=\"w-12 h-12 rounded-lg bg-amber-100 dark:bg-amber-900/20 text-amber-600 dark:text-amber-500 flex items-center justify-center mb-6\">\n                {project.icon}\n              </div>\n              <h3 className=\"text-xl font-bold mb-2 text-neutral-900 dark:text-neutral-100\">{project.title}</h3>\n              <p className=\"text-sm text-amber-600 dark:text-amber-500 font-medium mb-4\">{project.category}</p>\n              <p className=\"text-neutral-600 dark:text-neutral-400 mb-6 flex-grow leading-relaxed\">\n                {project.description}\n              </p>\n              <div className=\"flex flex-wrap gap-2 mt-auto\">\n                {project.tech.map((tech, techIndex) => (\n                  <span\n                    key={techIndex}\n                    className=\"text-xs font-medium bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 px-3 py-1.5 rounded-md border border-neutral-200 dark:border-neutral-800\"\n                  >\n                    {tech}\n                  </span>\n                ))}\n              </div>\n            </motion.div>\n          ))}\n        </motion.div>\n\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.5 }}\n          className=\"mb-8\"\n        >\n          <h3 className=\"text-2xl font-bold tracking-tight mb-2 text-neutral-900 dark:text-neutral-50\">Additional Projects</h3>\n          <div className=\"w-12 h-1 bg-neutral-300 dark:bg-neutral-700 rounded\"></div>\n        </motion.div>\n\n        <motion.div\n          variants={containerVariants}\n          initial=\"hidden\"\n          whileInView=\"visible\"\n          viewport={{ once: true }}\n          className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\"\n        >\n          {additionalProjects.map((project, index) => (\n            <motion.div\n              key={index}\n              variants={itemVariants}\n              whileHover={{ scale: 1.01, y: -2 }}\n              className=\"bg-white dark:bg-neutral-950 rounded-lg border border-neutral-200 dark:border-neutral-800 p-6 hover:border-neutral-300 dark:hover:border-neutral-700 hover:shadow-md transition-all duration-300\"\n            >\n              <h4 className=\"text-lg font-bold mb-1 text-neutral-900 dark:text-neutral-100\">{project.title}</h4>\n              <p className=\"text-sm text-neutral-500 dark:text-neutral-400 mb-3\">{project.category}</p>\n              <p className=\"text-sm text-neutral-600 dark:text-neutral-400 mb-4\">\n                {project.description}\n              </p>\n              <div className=\"flex flex-wrap gap-2 mt-auto\">\n                {project.tech.map((tech, techIndex) => (\n                  <span\n                    key={techIndex}\n                    className=\"text-xs font-medium bg-neutral-50 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 px-2 py-1 rounded border border-neutral-100 dark:border-neutral-800\"\n                  >\n                    {tech}\n                  </span>\n                ))}\n              </div>\n            </motion.div>\n          ))}\n        </motion.div>\n      </div>\n    </section>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
