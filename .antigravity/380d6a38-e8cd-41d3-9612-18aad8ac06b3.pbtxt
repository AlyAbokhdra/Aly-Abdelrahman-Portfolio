      replacement_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport Link from \"next/link\";\nimport { ArrowRight, BookOpen } from \"lucide-react\";\n\n// Placeholder blog data - to be replaced with real CMS/Markdown data later\nconst blogPosts = [\n  {\n    id: 1,\n    title: \"Understanding ECM and Its Role in Modern Banking\",\n    excerpt: \"Enterprise Content Management is more than just document storage. Explore how systems like FileNet and ICN automate complex workflows.\",\n    date: \"Oct 15, 2023\",\n    readTime: \"5 min read\",\n  },\n  {\n    id: 2,\n    title: \"Building Scalable Microservices with Java and Spring Boot\",\n    excerpt: \"A deep dive into architectural patterns for creating resilient backend services in enterprise environments.\",\n    date: \"Sep 28, 2023\",\n    readTime: \"8 min read\",\n  },\n  {\n    id: 3,\n    title: \"Automating Document Ingestion: A Case Study\",\n    excerpt: \"How a multi-threaded Java ingestion service eliminated manual upload processes for a major financial institution.\",\n    date: \"Aug 10, 2023\",\n    readTime: \"6 min read\",\n  },\n];\n\nexport function Blog() {\n  return (\n    <section id=\"blog\" className=\"py-20\">\n      <div className=\"container mx-auto px-4 sm:px-6 lg:px-8\">\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.5 }}\n          className=\"mb-12 flex flex-col sm:flex-row sm:items-end justify-between gap-4\"\n        >\n          <div>\n            <h2 className=\"text-3xl font-bold tracking-tight mb-2\">Technical Blog</h2>\n            <div className=\"w-16 h-1 bg-blue-600 rounded\"></div>\n          </div>\n          <Link\n            href=\"#\"\n            className=\"inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-500 hover:underline\"\n          >\n            View all articles\n            <ArrowRight className=\"ml-1 h-4 w-4\" />\n          </Link>\n        </motion.div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {blogPosts.map((post, index) => (\n            <motion.article\n              key={post.id}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: index * 0.1 }}\n              className=\"group flex flex-col items-start justify-between\"\n            >\n              <div className=\"flex items-center gap-x-4 text-xs mb-4\">\n                <time dateTime={post.date} className=\"text-neutral-500\">\n                  {post.date}\n                </time>\n                <span className=\"text-neutral-300 dark:text-neutral-700\">\342\200\242</span>\n                <span className=\"flex items-center text-neutral-500\">\n                  <BookOpen className=\"mr-1 h-3 w-3\" />\n                  {post.readTime}\n                </span>\n              </div>\n              <div className=\"group relative\">\n                <h3 className=\"mt-3 text-xl font-bold leading-6 text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-500 transition-colors\">\n                  <Link href={`#`}>\n                    <span className=\"absolute inset-0\" />\n                    {post.title}\n                  </Link>\n                </h3>\n                <p className=\"mt-5 line-clamp-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400\">\n                  {post.excerpt}\n                </p>\n              </div>\n            </motion.article>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
